# Local SQLite user/session database is created automatically as auth.sqlite.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
# Set this only when Nginx is the sole proxy and Node binds to loopback.
DASHBOARD_TRUST_PROXY=loopback
# Remote binding requires TLS certificate and private key paths; keep the key outside this repository.
# DASHBOARD_TLS_KEY=/etc/ssl/private/dashboard.key
# DASHBOARD_TLS_CERT=/etc/ssl/certs/dashboard.crt
# Password reset email delivery (signup and login work without SMTP configuration).
# Set this to the HTTPS dashboard URL when enabling password reset emails.
# PUBLIC_BASE_URL=https://your-dashboard.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
